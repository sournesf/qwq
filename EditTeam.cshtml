@model WebApplication2.Models.Team

@{
    ViewData["Title"] = "Редактировать команду";
}

<div class="container mt-5 mb-5">
    <div class="card bg-black text-white border-danger shadow-lg mx-auto"
         style="max-width: 650px;">

        <div class="card-header border-danger p-3">
            <h2 class="text-danger mb-0">⚔ Редактирование команды</h2>
        </div>

        <div class="card-body p-4">
            <p class="text-secondary mb-4">
                Измени информацию о своей команде.
            </p>

            <form asp-controller="Captain"
                  asp-action="EditTeam"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input asp-for="TeamId" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">
                        Название команды
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Country" class="form-label fw-bold">
                        Страна
                    </label>
                    <input asp-for="Country" class="form-control" />
                    <span asp-validation-for="Country"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Founded" class="form-label fw-bold">
                        Год основания
                    </label>
                    <input asp-for="Founded"
                           type="number"
                           class="form-control"
                           min="1990"
                           max="2100" />
                    <span asp-validation-for="Founded"
                          class="text-danger"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Текущий логотип
                        </label>
                        <div>
                            <img src="@Model.Image"
                                 alt="@Model.Name"
                                 class="img-thumbnail bg-dark"
                                 style="max-width: 180px; max-height: 180px; object-fit: contain;" />
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label for="imageFile" class="form-label fw-bold">
                        Новый логотип команды
                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div class="form-text text-secondary">
                        JPG, JPEG, PNG или WEBP. Максимальный размер — 5 МБ.
                        Если не выбирать файл, текущий логотип останется.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        Сохранить изменения
                    </button>

                    <a asp-controller="Captain"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
21:34
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}