@model WebApplication2.Models.Player

@{
    ViewData["Title"] = "Редактирование игрока";
}

<style>
    .edit-player-page {
        max-width: 650px;
        margin: 40px auto;
        color: #f5f5f5;
    }

    .edit-player-card {
        background: #171717;
        border: 1px solid #6b2525;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, .35);
    }

    .edit-player-header {
        background: #a71919;
        padding: 20px;
    }

    .edit-player-body {
        padding: 25px;
    }

    .edit-player-page .form-label {
        color: #f1f1f1;
        font-weight: 600;
    }

    .edit-player-page .form-control,
    .edit-player-page .form-select {
        background-color: #252525;
        border: 1px solid #444;
        color: white;
    }

        .edit-player-page .form-control:focus,
        .edit-player-page .form-select:focus {
            border-color: #ff4d4d;
            box-shadow: 0 0 0 .2rem rgba(255, 77, 77, .2);
        }

    .edit-player-page option {
        background: #252525;
        color: white;
    }
</style>

<div class="container edit-player-page">
    <div class="edit-player-card">

       
        <div class="edit-player-header">
            <h2 class="mb-0">⚔ Редактирование игрока</h2>
        </div>

        <div class="edit-player-body">

            <form asp-controller="Captain"
                  asp-action="EditPlayer"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PlayerId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nickname" class="form-label">
                        Никнейм игрока
                    </label>

                    <input asp-for="Nickname"
                           class="form-control"
                           placeholder="Например, Yatoro" />

                    <span asp-validation-for="Nickname"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position" class="form-label">
                        Позиция
                    </label>

                    <select asp-for="Position" class="form-select">
                        <option value="Carry">Carry</option>
                        <option value="Mid">Mid</option>
                        <option value="Offlane">Offlane</option>
                        <option value="Support">Support</option>
                        <option value="Hard Support">Hard Support</option>
                    </select>

                    <span asp-validation-for="Position"
                          class="text-danger"></span>
                </div>

                 <div class="mb-4">
                    <label class="form-label">
                        Изображение игрока
                    </label>

                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <div class="mb-3">
                            <img src="@Url.Content(
                                 Model.Image.StartsWith("/")
                                    || Model.Image.StartsWith("~/")
                                    ? Model.Image
                                    : "~/images/" + Model.Image)"
                                 alt="Изображение игрока"
                                 style="max-width:180px; max-height:180px; object-fit:contain;" />
                        </div>
                    }

                    <input type="file"
                           name="imageFile"
                          
                           accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" />

                    <div class="form-text text-secondary">
                        Оставь поле пустым, чтобы сохранить текущее изображение.
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-danger">
                          Сохранить изменения
                    </button>

                    <a asp-controller="Captain"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Назад
                    </a>
                </div>

            </form>
        </div>
    </div>
    

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}