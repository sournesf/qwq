@model WebApplication2.Models.Team

@{
    ViewData["Title"] = "Создать команду";
}

<div class="container mt-5 mb-5">
    <div class="card bg-black text-white border-danger shadow-lg mx-auto"
         style="max-width: 650px;">

        <div class="card-header border-danger p-3">
            <h2 class="text-danger mb-0">⚔ Создание команды Dota 2</h2>
        </div>

        <div class="card-body p-4">
            <p class="text-secondary mb-4">
                Создай свою команду и начни собирать состав.
            </p>

            <form asp-controller="Captain"
                  asp-action="CreateTeam"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">
                        Название команды
                    </label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Например, Team Spirit" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Country" class="form-label fw-bold">
                        Страна
                    </label>
                    <input asp-for="Country"
                           class="form-control"
                           placeholder="Например, Россия" />
                    <span asp-validation-for="Country"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Founded" class="form-label fw-bold">
                        Год основания
                    </label>
                    <input asp-for="Founded"
                           type="number"
                           class="form-control"
                           min="1990"
                           max="2100"
                           placeholder="Например, 2020" />
                    <span asp-validation-for="Founded"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label for="imageFile" class="form-label fw-bold">
                        Логотип команды
                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <div class="form-text text-secondary">
                        Поддерживаются JPG, JPEG, PNG и WEBP.
                        Максимальный размер — 5 МБ.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">
                        Создать команду
                    </button>

                    <a asp-controller="Captain"
                       asp-action="Index"
                       class="btn btn-outline-light">
                        Назад
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}